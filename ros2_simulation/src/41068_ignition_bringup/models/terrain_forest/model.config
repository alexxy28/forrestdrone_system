<?xml version="1.0"?>
<model>
  <name>terrain_forest</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>
  <description>
    The terrain_1 hills with the grass texture tiled every ~5 m, for the demo_2 world.
    Same geometry and the same 290 K thermal temperature as terrain_1, so mapping,
    the Husky route and heat detection behave exactly as in terrain_demo.
  </description>
</model>
