      <pose>-4 4 0 0 0 0</pose>
      <static>true</static>
      <link name="body">
        <collision name="body_collision">
          <pose>0 0 0.25 0 0 0</pose>
          <geometry>
            <sphere><radius>0.35</radius></sphere>
          </geometry>
        </collision>
        <visual name="body_visual">
          <pose>0 0 0.25 0 0 0</pose>
          <geometry>
            <sphere><radius>0.35</radius></sphere>
          </geometry>
          <material>
            <ambient>0.35 0.20 0.10 1</ambient>
            <diffuse>0.45 0.26 0.12 1</diffuse>
          </material>
          <plugin
            filename="ignition-gazebo-thermal-system"
            name="gz::sim::systems::Thermal">
            <temperature>390.0</temperature>
          </plugin>
        </visual>
        <visual name="nose_visual">
          <pose>0.32 0 0.25 0 1.5708 0</pose>
          <geometry>
            <cylinder><radius>0.10</radius><length>0.25</length></cylinder>
          </geometry>
          <material>
            <ambient>0.10 0.07 0.05 1</ambient>
            <diffuse>0.12 0.08 0.05 1</diffuse>
          </material>
          <plugin
            filename="ignition-gazebo-thermal-system"
            name="gz::sim::systems::Thermal">
            <temperature>390.0</temperature>
          </plugin>
        </visual>
      </link>
    </model>
    <!--
      Dummy pose array for the human model:
      [0] -15 -10 1 -1.7 0 0
      [1] -15 0 0 -1.25 0 0
      [2] -15 15 0 -1.5 0 0
      [3] 12 15 1.4 -1.5 0 0
      [4] 12 -5 0.75 -1.7 0 0 
      [5] 2.3978 12.5679 0.4785 -1.7 0 0
      
      SDFormat itself cannot randomly choose one at startup.
    -->

    <include>
      <uri>model://human</uri>
      <name>human_heat1</name>
      <pose>-15 -10 1 -1.7 0 0</pose>
    </include>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>9.0 -12.0 6.0 0.0 0.3 2.2</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
  </world>
</sdf>
