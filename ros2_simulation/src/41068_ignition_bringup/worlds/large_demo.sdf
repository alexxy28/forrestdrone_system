<?xml version="1.0"?>
<sdf version='1.8'>
  <world name="large_demo">
    <!-- Basic world setup  -->
    <light name="sun" type="directional">
      <cast_shadows>0</cast_shadows>
      <pose>0 0 100 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <!-- <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation> -->
      <direction>-0.5 0.1 -0.9</direction>
      <intensity>5</intensity>
    </light>
    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <physics name="default_physics" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>
    <scene>
      <ambient>1.0 1.0 1.0 1</ambient>
      <background>0.6 0.8 1.0 1</background>
      <shadows>0</shadows>
      <grid>0</grid>
    </scene>

    <!-- Initialise spherical coordinates somewhere -->
    <spherical_coordinates>
      <latitude_deg>0.0</latitude_deg>
      <longitude_deg>0.0</longitude_deg>
      <elevation>10.0</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <!-- Large ground planes with forest floor texture -->
    <include>
      <uri>
        model://forest_plane
      </uri>
      <name>forest_plane</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    
    <!-- Forest wall -->
    <include>
      <uri>
        model://forest_wall
      </uri>
      <name>forest_wall1</name>
      <pose>25 0 2 1.570796 0 -1.570796</pose>
    </include>
    <include>
      <uri>
        model://forest_wall
      </uri>
      <name>forest_wall2</name>
      <pose>25 -18.64 2 1.570796 0 -1.570796</pose>
    </include>
    <include>
      <uri>
        model://forest_wall
      </uri>
      <name>forest_wall3</name>
      <pose>25 +18.64 2 1.570796 0 -1.570796</pose>
    </include>
    <include>
      <uri>
        model://forest_wall
      </uri>
      <name>forest_wall4</name>
      <pose>-25 0 2 1.570796 0 1.570796</pose>
    </include>
    <include>
      <uri>
        model://forest_wall
      </uri>
      <name>forest_wall5</name>
      <pose>-25 -18.64 2 1.570796 0 1.570796</pose>
    </include>
    <include>
      <uri>
        model://forest_wall
      </uri>
      <name>forest_wall6</name>
      <pose>-25 +18.64 2 1.570796 0 1.570796</pose>
    </include>
    <include>
      <uri>
        model://forest_wall
      </uri>
      <name>forest_wall7</name>
      <pose>0 -25 2 1.570796 0 0</pose>
    </include>
    <include>
      <uri>
        model://forest_wall
      </uri>
      <name>forest_wall8</name>
      <pose>-18.64 -25 2 1.570796 0 0</pose>
    </include>
    <include>
      <uri>
        model://forest_wall
      </uri>
      <name>forest_wall9</name>
      <pose>+18.64 -25 2 1.570796 0 0</pose>
    </include>
    <include>
      <uri>
        model://forest_wall
      </uri>
      <name>forest_wall10</name>
      <pose>0 25 2 1.570796 0 0</pose>
    </include>
    <include>
      <uri>
        model://forest_wall
      </uri>
      <name>forest_wall11</name>
      <pose>-18.64 25 2 1.570796 0 0</pose>
    </include>
    <include>
      <uri>
        model://forest_wall
      </uri>
      <name>forest_wall12</name>
      <pose>+18.64 25 2 1.570796 0 0</pose>
    </include>
    <!-- Hill Models ( Basically just rectangles and triangles for now) -->
    <model name="hill1">
      <pose>20 0 0 0 0 0</pose>
      <static>true</static>
      <link name="hill1_link">
        <collision name="hill1_collision">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry>
            <box><size>10 10 1</size></box>
          </geometry>
        </collision>
        <visual name="hill1_visual">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry>
            <box><size>10 10 1</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.8 0.2 1</ambient>
            <diffuse>0.2 0.8 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="hill2">
      <pose>0 -10 0 0 0 0</pose>
      <static>true</static>
      <link name="hill2_link">
        <collision name="hill2_collision">
          <pose>0 -10 0.5 0 0 0</pose>
          <geometry>
            <box><size>50 10 1</size></box>
          </geometry>
        </collision>
        <visual name="hill2_visual">
          <pose>0 -10 0.5 0 0 0</pose>
          <geometry>
            <box><size>50 10 1</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.8 0.2 1</ambient>
            <diffuse>0.2 0.8 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <!-- Tree models: all replacements use the local demo_tree_healthy geometry so the heat sensor stays stable while keeping the original positions. -->
    <model name="oak1">
      <pose>-4.77393 12.2995 -0.3 0 0 0</pose>
      <static>true</static>
      <link name="tree">
        <collision name="trunk_collision">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry><cylinder><radius>0.18</radius><length>1.5</length></cylinder></geometry>
        </collision>
        <collision name="canopy_collision">
          <pose>0 0 1.75 0 0 0</pose>
          <geometry><sphere><radius>0.75</radius></sphere></geometry>
        </collision>
        <visual name="trunk_visual">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry><cylinder><radius>0.18</radius><length>1.5</length></cylinder></geometry>
          <material>
            <ambient>0.35 0.20 0.08 1</ambient>
            <diffuse>0.35 0.20 0.08 1</diffuse>
          </material>
        </visual>
        <visual name="canopy_visual">
          <pose>0 0 1.75 0 0 0</pose>
          <geometry><sphere><radius>0.75</radius></sphere></geometry>
          <material>
            <ambient>0.05 0.45 0.08 1</ambient>
            <diffuse>0.05 0.45 0.08 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
